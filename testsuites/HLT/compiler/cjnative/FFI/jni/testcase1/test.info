// LEVEL: 2
// DEPENDENCE: cj cpp java ../utils/Cangjie.h
// EXEC: mkdir -p build/classes
// EXEC: mkdir -p build/lib
// (target_linux & target_x86_64) EXEC: cp $CANGJIE_HOME/runtime/lib/linux_x86_64_cjnative/libcangjie-runtime.so build/lib
// (target_linux & target_x86_64) EXEC: cp $CANGJIE_HOME/runtime/lib/linux_x86_64_cjnative/libsecurec.so build/lib
// (target_android) EXEC: cp $CANGJIE_HOME/runtime/lib/linux_android_aarch64_cjnative/libcangjie-runtime.so build/lib
// (target_android) EXEC: cp $CANGJIE_HOME/runtime/lib/linux_android_aarch64_cjnative/libsecurec.so build/lib
// (target_linux & target_x86_64) EXEC: clang++ -std=c++17 -fPIC -shared cpp/call_cangjie.cpp -I. -Icpp -I$JAVA_HOME/include -I$JAVA_HOME/include/linux -o build/lib/libjni_native.so -Lbuild/lib -lcangjie-runtime -lsecurec -pthread
// (target_android) EXEC: clang++ -std=c++17 -fPIC -shared cpp/call_cangjie.cpp -I. -Icpp -I$JAVA_HOME/include -I$JAVA_HOME/include/darwin -o build/lib/libjni_native.so -Lbuild/lib -lcangjie-runtime -lsecurec -pthread
// EXEC: cjc cj/javaCallcj.cj --output-type=dylib --output-dir build/lib -Lbuild/lib -ljni_native
// EXEC: javac -d build/classes java/*.java
// EXEC: export LD_LIBRARY_PATH=build/lib:$LD_LIBRARY_PATH && java -Djava.library.path=build/lib -cp build/classes Main
