// (CJNATIVE and not Windows) DEPENDENCE: ../%n
// (CJNATIVE and not Windows) RUN-EXEC-0: %cd %n && mkdir -p out
// (CJNATIVE and not Windows) RUN-EXEC-0: %cd %n && %compiler %compile_shared_lib_opt %overflowOpt -p src/cjworld %import_objc_interop -o out
// (CJNATIVE and Linux) RUN-EXEC-0: %cd %n && %clang %objc_flags %objc_base_libs %objc_arc_opt src/objc/*.m objc-gen/*.m -o out/main -Lout %cangjie_runtime_link %clang_link_objc_interop -lgnustep-corebase -I../ -Isrc/objc -Iobjc-gen %include_cangjie -lcjworld -lcangjie-runtime
// (CJNATIVE and Darwin) RUN-EXEC-0: %cd %n && %clang %modules_opt %objc_arc_opt src/objc/*.m objc-gen/*.m -o out/main -Lout %cangjie_runtime_link %clang_link_objc_interop -I../ -Isrc/objc -Iobjc-gen %include_cangjie -lcjworld -lcangjie-runtime
// (CJNATIVE and not Windows) RUN-EXEC-PIPE: %cd %n/out && ./main 2>& 1 | compare %f

/* SCAN-IN
cj: createObject()
cj: A()
objc: after createObject -> A(visits=1)
cj: collectGarbage()
objc: after collectGarbage -> A(visits=1)
cj: collectGarbage()
objc: after round trip through NSMutableArray -> A(visits=1)
cj: acceptObject(A(visits=1))
cj: downcast to A succeeded, visits=1
cj: after visit, visits=2
objc: after acceptObject -> A(visits=2)
*/
