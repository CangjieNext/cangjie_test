// Test: @JavaImpl common instance fields with initializers are initialized on the specific side
// Scenario: A common class declares mutable (`var`) and immutable (`let`) instance fields with
//           initializers; the specific side implements it as @JavaImpl. The fields are relocated
//           to the registry companion, so their initializers must be replayed by CHIR patching
//           (the specific class-level $varInit is rebuilt empty).
// Expected: Both `var` and `let` fields carry their initialized values (not the companion's zero
//           value), and a `var` field is writable through the proxy setter.

// (CJNATIVE and not Windows) DEPENDENCE: ../%n
// (CJNATIVE and not Windows) RUN-EXEC-0: %cd %n && mkdir -p build
// (CJNATIVE and not Windows) RUN-EXEC-0: %cd %n && cjc --experimental src/cj/common.cj --output-type chir --output-dir build %import_java_interop
// (CJNATIVE and not Windows) RUN-EXEC-0: %cd %n && cjc --experimental src/cj/specific.cj --common-part-chir=build/demo.chir --common-part-cjo=build/demo.cjo --output-type dylib -o build/libdemo.so %import_java_interop --output-javagen-dir=src/java/cj
// (CJNATIVE and not Windows) RUN-EXEC-0: %cd %n && %javac %cp_cj_loader_java_interop src/java/cj/*.java -h ./ -d ./
// (CJNATIVE and not Windows) RUN-EXEC-PIPE: %cd %n && LD_LIBRARY_PATH=$CANGJIE_HOME/runtime/lib/linux_x86_64_cjnative:./build:$LD_LIBRARY_PATH %java %cp_cj_loader_java_interop demo.MyMain 2>& 1 | compare %f

/* SCAN-IN
iv=7
lv=-3
cv=11
sum=15
iv=100
*/
