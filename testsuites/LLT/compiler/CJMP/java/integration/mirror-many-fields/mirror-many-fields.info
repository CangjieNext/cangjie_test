// Test: CJMP field access must not mix up fields of the same type / prefix names
// Scenario: Common class has several Int32 fields named so that one name is a
//           prefix of another (abc/ab/a), specific @JavaMirror mirrors a Java
//           class with distinct values per field.
// Expected: Every field keeps its own value; reads and writes are not rewired to
//           another field's accessor.

// (CJNATIVE and not Windows) DEPENDENCE: ../%n
// (CJNATIVE and not Windows) RUN-EXEC-0: %cd %n && mkdir -p build
// (CJNATIVE and not Windows) RUN-EXEC-0: %cd %n && cjc --experimental src/cj/common.cj --output-type chir --output-dir build %import_java_interop
// (CJNATIVE and not Windows) RUN-EXEC-0: %cd %n && cjc --experimental src/cj/specific.cj --common-part-chir=build/pkgcj.chir --common-part-cjo=build/pkgcj.cjo --output-type dylib -o build/libdemo.so %import_java_interop --output-javagen-dir=src/java/cj
// (CJNATIVE and not Windows) RUN-EXEC-0: %cd %n && %javac %cp_cj_loader_java_interop src/java/pkgj/WithFields.java src/java/cj/*.java -h ./ -d ./
// (CJNATIVE and not Windows) RUN-EXEC-PIPE: %cd %n && LD_LIBRARY_PATH=$CANGJIE_HOME/runtime/lib/linux_x86_64_cjnative:./build:$LD_LIBRARY_PATH %java %cp_cj_loader_java_interop pkgcj.MyMain 2>& 1 | compare %f

