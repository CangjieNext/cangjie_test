// A runtime as conversion stays outside local unreachable-value propagation.
// EXEC-PIPE-0: %compiler %cmp_opt %f -o %output 2>&1 | compare %f

main() {
    let base: Any = 1
    let converted = base as String
    if (let value <- converted) {
        println(value)
    }
}

